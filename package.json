{
	"name": "n8n-nodes-xentral",
	"version": "1.0.10",
	"description": "The most comprehensive n8n community node for Xentral ERP - 30 resources, 196 operations, 73 webhook events. Full API audit verified. Built by next8n.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"xentral",
		"erp",
		"workflow",
		"automation",
		"xentral-erp",
		"next8n",
		"crm",
		"invoicing",
		"warehouse",
		"e-commerce"
	],
	"license": "FUCL",
	"author": {
		"name": "Mirza Iqbal / next8n",
		"url": "https://next8n.com"
	},
	"homepage": "https://next8n.com",
	"repository": {
		"type": "git",
		"url": ""
	},
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials --ext .ts",
		"test": "npm run build && node --test test/",
		"prepublishOnly": "cp README.md README.dev.md && cp README.npm.md README.md && npm run build",
		"postpublish": "mv README.dev.md README.md"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/XentralApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Xentral/Xentral.node.js",
			"dist/nodes/Xentral/XentralTrigger.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^1.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
