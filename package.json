{
	"name": "n8n-nodes-xentral",
	"version": "1.4.6",
	"description": "n8n community node for Xentral ERP. 41 resources, 257 operations, a Custom API Call for every endpoint, and a trigger for 162 webhook events. Built by next8n.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"xentral",
		"erp",
		"workflow",
		"automation",
		"xentral-erp",
		"next8n",
		"crm",
		"invoicing",
		"warehouse",
		"e-commerce"
	],
	"license": "MIT",
	"author": {
		"name": "Mirza Iqbal",
		"email": "support@next8n.com",
		"url": "https://next8n.com"
	},
	"homepage": "https://github.com/mjmirza/n8n-nodes-xentral#readme",
	"bugs": {
		"url": "https://github.com/mjmirza/n8n-nodes-xentral/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mjmirza/n8n-nodes-xentral.git"
	},
	"scripts": {
		"build": "tsc && node scripts/copy-assets.mjs",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint package.json nodes credentials",
		"test": "npm run build && node --test test/*.test.mjs",
		"lint:fix": "eslint package.json nodes credentials --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/XentralApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Xentral/Xentral.node.js",
			"dist/nodes/Xentral/XentralTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.38.1",
		"@types/node": "^22.20.5",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "9.29.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"n8n-workflow": "2.45.4",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22"
	}
}
