{
	"name": "n8n-nodes-xentral",
	"version": "0.1.0",
	"description": "n8n community node for Xentral ERP integration",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"xentral",
		"erp",
		"workflow",
		"automation"
	],
	"license": "MIT",
	"author": {
		"name": "Mirza Iqbal"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/mirzaiqbal/n8n-nodes-xentral"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials --ext .ts",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/XentralApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Xentral/Xentral.node.js",
			"dist/nodes/Xentral/XentralTrigger.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^1.0.0",
		"prettier": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
